# 复制为 .env 后按需修改（.env 不入库）
# 环境变量优先级高于 config/config.yaml

# ---------- 默认后端：DeepSeek 官方 API ----------
# 获取地址：https://platform.deepseek.com/api_keys
# 绝不硬编码到仓库，绝不提交到 git
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 后端类型：api | web | openai | ollama
DS_AGENT_BACKEND=api

# ---------- 网页后端（高风险，默认关闭） ----------
# 启用前请阅读 README 顶部的免责声明
DS_AGENT_DS_READ_SCRIPT=
DS_AGENT_SESSION_ID=
DS_AGENT_DRIVER=pyautogui

# ---------- 通用 ----------
DS_AGENT_WORKSPACE_DIR=workspace
DS_AGENT_LOG_LEVEL=INFO
DS_AGENT_OLLAMA_HOST=http://127.0.0.1:11434

# ---------- Web 配置管理面板 ----------
DS_AGENT_ADMIN_HOST=127.0.0.1
DS_AGENT_ADMIN_PORT=8765
DS_AGENT_ADMIN_PASSWORD_HASH=
